{
  "//": "VS Code / 任何支持 jsconfig 的编辑器：让扩展源码、Node 脚本、测试都有补全与跳转定义。",
  "//2": "扩展本体（src/）是普通脚本，没有模块系统；工具与测试是 Node ESM；两边都收进来但不做严格类型检查。",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.js",
    "tools/**/*.mjs",
    "test/**/*.mjs",
    "manifest.json"
  ],
  "exclude": [
    "node_modules",
    "dsh-install-*",
    "dsh/node_modules",
    "mobile/index.html"
  ]
}
